# feedsystem_video_go 环境变量模板
# 复制此文件为 .env 后修改实际值
# .env 已被 .gitignore 忽略，不会提交到仓库

# MySQL
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=feedsystem

# Redis
REDIS_PASSWORD=123456

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASS=password123

# JWT (生产环境务必修改为随机强密钥)
JWT_SECRET=feedsystem-dev-secret-key

# 飞书群机器人（Bug 平台通知）
# 飞书群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人，复制 webhook 地址
# 留空时 compose 默认指向本地 feishu-mock 模拟器——通知只进模拟器，正式飞书群不会收到任何消息！
# 服务器上务必填真实 webhook，且改完 .env 必须 docker compose up -d backend 重建容器（restart 不会重新注入 env）
FEISHU_WEBHOOK_URL=
# 机器人若开启「签名校验」则填入密钥（Signing Secret）；未开启留空
FEISHU_WEBHOOK_SECRET=
# 平台用户名 → 飞书 open_id 映射（真 @ 提醒）：形如 张三=ou_xxx,李四=ou_yyy
# open_id 获取方式见 DEPLOY.md「飞书真 @ 通知」一节；未映射到的成员降级为 @所有人
FEISHU_AT_MAP=
